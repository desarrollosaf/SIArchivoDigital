# Plantilla de configuracion. Copiala a .env y captura los valores reales:
#     cp backend/.env.example backend/.env
# El archivo .env no se versiona: trae las credenciales del servidor.

PORT=3060

# ---------------------------------------------------------------------
# Conexion principal (default): base de datos de Archivo Digital
# (adminplem_archivoDigital). Es la misma que usa el sistema Laravel, asi
# que ambos pueden convivir durante la migracion.
#
# DB_HOST segun donde este el servidor:
#   host.docker.internal  MySQL en esta misma maquina y el backend en Docker
#   localhost              MySQL en esta misma maquina y el backend con npm
#   10.0.0.25 / mysql.interno   servidor de red (pon su IP o su nombre)
# ---------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=adminplem_archivoDigital

# ---------------------------------------------------------------------
# Conexion externa (adminplem_saf): usuarios para el login y padron de
# servidores publicos (s_usuario, s_users, t_departamento...).
# ---------------------------------------------------------------------
DB_EXTERNAL_HOST=
DB_EXTERNAL_PORT=3306
DB_EXTERNAL_USERNAME=
DB_EXTERNAL_PASSWORD=
DB_EXTERNAL_DATABASE=adminplem_saf

# ---------------------------------------------------------------------
# Conexion del Legislativo (adminplem_congresoedomex): catalogo de
# comisiones para los eventos legislativos de Presidencia. Solo lectura.
# ---------------------------------------------------------------------
DB_LEGISLATIVO_HOST=
DB_LEGISLATIVO_PORT=3306
DB_LEGISLATIVO_USERNAME=
DB_LEGISLATIVO_PASSWORD=
DB_LEGISLATIVO_DATABASE=adminplem_congresoedomex

# Secreto de firma del token. Generalo con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

# Carpeta donde viven los documentos. Copia aqui el contenido de
# storage/app del sistema Laravel (carpetas registros/, Conclusion/,
# comentarios/...) para que los archivos historicos sigan abriendo.
# Si se deja vacio se usa backend/uploads.
UPLOADS_DIR=

# ---------------------------------------------------------------------
# Avisos de cumpleanos por WhatsApp (UltraMsg, el mismo proveedor que
# usaba Laravel). Mientras WHATSAPP_ACTIVO no sea true no se envia nada:
# dejalo en false en local/pruebas. Los telefonos que reciben los avisos
# se capturan en Administracion -> Avisos por WhatsApp.
# Activalo solo cuando se apague el cron de Laravel, o llegaran repetidos.
# ---------------------------------------------------------------------
WHATSAPP_ACTIVO=false
ULTRAMSG_API_URL=https://api.ultramsg.com
# Ej. instance114748 (la que usaba Laravel para los cumpleanos)
ULTRAMSG_INSTANCIA=
ULTRAMSG_TOKEN=
