# Etapa de compilación
FROM node:24-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build

# Etapa de producción
FROM node:24-alpine AS production

WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./

# Se instalan tambien las devDependencies porque sequelize-cli (migrate/seed)
# se ejecuta dentro de este contenedor via "docker compose exec backend npm run migrate".
RUN npm ci

COPY --from=build /app/dist ./dist

# sequelize-cli no lee dist/: .sequelizerc resuelve migrations/seeders/models
# relativos a src/database, asi que ese codigo fuente viaja tal cual.
COPY --from=build /app/src/database ./src/database
COPY --from=build /app/.sequelizerc ./.sequelizerc

# Revisión de que los archivos de la base existan en uploads (npm run verificar-archivos).
COPY --from=build /app/scripts/verificar-archivos.js ./scripts/verificar-archivos.js

# Membrete del PDF de cumpleaños que se envía por WhatsApp.
COPY --from=build /app/assets ./assets

RUN mkdir -p /app/uploads

EXPOSE 3060

CMD ["node", "dist/main.js"]
